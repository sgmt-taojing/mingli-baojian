{
  "consumer": {
    "name": "mingli-baojian-h5"
  },
  "interactions": [
    {
      "description": "a health check request",
      "providerStates": [
        {
          "name": "服务正常运行"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/health"
      },
      "response": {
        "body": {
          "ok": true,
          "ts": 1700000000000,
          "v1": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.ts": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request for KB file list",
      "providerStates": [
        {
          "name": "KB 文件存在"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/kb/list"
      },
      "response": {
        "body": {
          "code": 0,
          "data": {
            "files": [
              {
                "desc": "五行知识",
                "filename": "nihaisha-wuxing.js",
                "level": "public"
              }
            ]
          },
          "message": "ok"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data.files": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data.files[*].desc": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.files[*].filename": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data.files[*].level": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request for a specific KB module file",
      "providerStates": [
        {
          "name": "KB 模块文件存在"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/javascript"
        },
        "method": "GET",
        "path": "/api/kb/nihaisha-wuxing.js"
      },
      "response": {
        "body": "// KB content placeholder",
        "headers": {
          "Cache-Control": "public, max-age=3600",
          "Content-Type": "application/javascript"
        },
        "status": 200
      }
    },
    {
      "description": "a v1 alias request that should redirect",
      "providerStates": [
        {
          "name": "v1 alias 已注册"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/kb/list"
      },
      "response": {
        "headers": {
          "Location": "/api/kb/list"
        },
        "status": 308
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "mingli-baojian-api"
  }
}